<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        Cleartext HTTP is required: this is a LAN-only tool. The tablet talks to bridge
        programs running on laptops on the same private local network (RFC1918 addresses,
        e.g. http://192.168.x.x:8080) which have no TLS certificates and no public internet
        exposure. A networkSecurityConfig <domain> allowlist cannot express this, because
        Android matches <domain> entries by hostname suffix and does not support CIDR
        ranges, so a private-range allowlist would silently match nothing and block
        every send. Access is authenticated with the X-Api-Key header instead.
    -->
    <application
        android:name=".SurveyApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:label="Medical Mission Survey"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
